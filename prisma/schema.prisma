datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  password                String                   @default("1234")
  phone                   String?
  firebaseUid             String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bookings                Booking[]
  reviews                 Review[]
  tournamentRegistrations TournamentRegistration[]

  @@index([phone])
}

model TurfOwner {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @default("1234")
  phone     String?
  turfs     Turf[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turf {
  id               String         @id @default(uuid())
  ownerId          String
  owner            TurfOwner      @relation(fields: [ownerId], references: [id])
  name             String
  location         String
  pricePerHour     Float
  status           String         @default("PENDING") // PENDING, APPROVED, REJECTED
  city             String?
  area             String?
  sportType        String?
  capacity         String?
  latitude         Float?
  longitude        Float?
  amenities        String?
  images           String?        // JSON array of image URLs
  slotPrices       String?        // JSON mapping of slot times to prices
  activeSlots      String?        // JSON array of active slots
  blockedSlots     String         @default("[]")
  ownerBookedSlots String         @default("[]")
  bookings         Booking[]
  reviews          Review[]
  bogoOffers       BOGOOffer[]
  tournaments      Tournament[]
  slotDiscounts    SlotDiscount[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Booking {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  turfId             String
  turf               Turf     @relation(fields: [turfId], references: [id])
  date               String   // Using YYYY-MM-DD
  startTime          String   // e.g., "10:00"
  endTime            String   // e.g., "11:00"
  status             String   // PENDING, CONFIRMED, CANCELLED
  paymentOrderId     String?
  paymentId          String?
  paymentStatus      String?
  isBogo             Boolean  @default(false)
  bogoOfferId        String?
  freeSlot           String?
  discountAmount     Float    @default(0)
  discountPercentage Float    @default(0)
  slotDiscountId     String?
  originalAmount     Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([turfId, date, startTime, endTime])
}

model BOGOOffer {
  id        String   @id @default(uuid())
  turfId    String
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  offerDate String   // YYYY-MM-DD
  offerType String   @default("BUY_1_GET_1")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([turfId, offerDate])
  @@index([turfId, offerDate])
}

model SlotDiscount {
  id                 String   @id @default(uuid())
  turfId             String
  turf               Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  date               String   // YYYY-MM-DD
  slot               String   // Normalized slot label e.g. "06:00 - 07:00"
  discountPercentage Float
  label              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([turfId, date, slot])
  @@index([turfId, date])
}

model Tournament {
  id                    String                   @id @default(uuid())
  turfId                String
  turf                  Turf                     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name                  String
  sport                 String
  description           String?
  bannerUrl             String?
  tournamentType        String                   @default("Knockout") // Knockout, League, League + Knockout
  registrationStartDate String
  registrationEndDate   String
  startDate             String
  endDate               String
  matchStartTime        String?
  reportingTime         String?
  maxTeams              Int
  minTeams              Int                      @default(2)
  playersPerTeam        Int
  substitutePlayers     Int                      @default(0)
  registrationType      String                   @default("Team Registration") // Team Registration, Individual Registration
  registrationFee       Float                    @default(0)
  paymentRequired       Boolean                  @default(false)
  firstPrize            String?
  secondPrize           String?
  thirdPrize            String?
  mvpPrize              String?
  otherPrizes           String?
  rules                 String?
  contactName           String
  contactPhone          String
  whatsappNumber        String?
  contactEmail          String?
  status                String                   @default("Draft") // Draft, Registration Open, Registration Closed, Ongoing, Completed, Cancelled
  registrations         TournamentRegistration[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([turfId])
  @@index([status])
}

model TournamentRegistration {
  id                 String     @id @default(uuid())
  tournamentId       String
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationId     String     @unique // e.g. KICKO-T-123456
  teamName           String?
  captainName        String
  captainPhone       String
  captainEmail       String?
  players            String     // JSON array of player names/details
  substitutes        String?    // JSON array of substitute names/details
  registrationStatus String     @default("CONFIRMED") // PENDING, CONFIRMED, REJECTED, CANCELLED
  paymentStatus      String     @default("FREE") // FREE, PENDING, PAID, FAILED
  amount             Float      @default(0)
  paymentOrderId     String?
  paymentId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

model Admin {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  firebaseUid String?  @unique
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  turfId    String
  turf      Turf     @relation(fields: [turfId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, turfId]) // One review per user per turf
}

